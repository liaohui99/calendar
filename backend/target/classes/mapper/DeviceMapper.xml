<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.calendar.chart.dao.DeviceDao">
    <select id="selectByCondition" resultType="com.calendar.chart.entity.Device">
        SELECT * FROM device
        <where>
            <if test="locationId != null">
                AND location_id = #{locationId}
            </if>
            <if test="typeId != null">
                AND type_id = #{typeId}
            </if>
        </where>
    </select>
    <select id="countByLocationAndType" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM device
        <where>
            location_id = #{locationId}
            AND type_id = #{typeId}
            <if test="excludeId != null">
                AND id != #{excludeId}
            </if>
        </where>
    </select>
</mapper>